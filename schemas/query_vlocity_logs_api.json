{
  "openapi": "3.0.3",
  "info": {
    "title": "Query Vlocity Logs API",
    "description": "Query Salesforce Vlocity Error Logs by direct ID lookup or by agent LAN ID and timeframe search.",
    "version": "1.0.0"
  },
  "paths": {
    "/query-by-id": {
      "get": {
        "operationId": "getVlocityLogById",
        "summary": "Look up a Vlocity Error Log by Salesforce ID",
        "description": "Directly retrieves a Vlocity Error Log using its Salesforce record ID. Returns the log with parsed HTTP request/response payloads and extracted error details.",
        "parameters": [
          {
            "name": "log_id",
            "in": "query",
            "required": true,
            "schema": { "type": "string" },
            "description": "The Salesforce ID of the Vlocity Error Log (e.g., a9zPf000005MQAf)"
          }
        ],
        "responses": {
          "200": {
            "description": "Vlocity Error Log(s) with parsed details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VlocityLogResponse"
                }
              }
            }
          }
        }
      }
    },
    "/search": {
      "get": {
        "operationId": "searchVlocityLogs",
        "summary": "Search Vlocity Error Logs by agent and timeframe",
        "description": "Searches for Vlocity Error Logs matching a specific agent LAN ID within a time range. Use this when no direct Salesforce ID is available in the error message.",
        "parameters": [
          {
            "name": "user",
            "in": "query",
            "required": true,
            "schema": { "type": "string" },
            "description": "Agent LAN ID (e.g., G2CD, JH37)"
          },
          {
            "name": "start_time",
            "in": "query",
            "required": true,
            "schema": { "type": "string" },
            "description": "Start of time range in ISO 8601 format"
          },
          {
            "name": "end_time",
            "in": "query",
            "required": true,
            "schema": { "type": "string" },
            "description": "End of time range in ISO 8601 format"
          }
        ],
        "responses": {
          "200": {
            "description": "Matching Vlocity Error Logs",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VlocityLogResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "VlocityLogResponse": {
        "type": "object",
        "properties": {
          "logs": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "Id": { "type": "string" },
                "Name": { "type": "string" },
                "ErrorCode": { "type": "string" },
                "Functionality": { "type": "string" },
                "Status": { "type": "string" },
                "ContextId": { "type": "string" },
                "SourceName": { "type": "string" },
                "User": { "type": "string" },
                "Datetime": { "type": "string" },
                "ProcessIdentifier": { "type": "string" },
                "request_data": { "type": "object" },
                "response_data": { "type": "object" },
                "response_code": { "type": "string" },
                "response_status": { "type": "string" },
                "response_integration": { "type": "string" },
                "error_details": { "type": "string" },
                "exception_log_id": { "type": "string", "nullable": true }
              }
            }
          },
          "count": { "type": "integer" }
        }
      }
    }
  }
}
