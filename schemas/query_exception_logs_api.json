{
  "openapi": "3.0.3",
  "info": {
    "title": "Query Exception Logs API",
    "description": "Query Salesforce PS Exception Logs by direct ID lookup or by application/location search.",
    "version": "1.0.0"
  },
  "paths": {
    "/query-by-id": {
      "get": {
        "operationId": "getExceptionLogById",
        "summary": "Look up a PS Exception Log by Salesforce ID",
        "description": "Directly retrieves a PS Exception Log using its Salesforce record ID. Returns exception details including application, location, type, severity, and error message.",
        "parameters": [
          {
            "name": "log_id",
            "in": "query",
            "required": true,
            "schema": { "type": "string" },
            "description": "The Salesforce ID of the PS Exception Log (e.g., a1WPf0000041jC6MAI)"
          }
        ],
        "responses": {
          "200": {
            "description": "PS Exception Log details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExceptionLogResponse"
                }
              }
            }
          }
        }
      }
    },
    "/search": {
      "get": {
        "operationId": "searchExceptionLogs",
        "summary": "Search PS Exception Logs by application and location",
        "description": "Searches for PS Exception Logs matching a specific application (e.g., CCSP) and/or exception location.",
        "parameters": [
          {
            "name": "application",
            "in": "query",
            "required": false,
            "schema": { "type": "string" },
            "description": "Application name (e.g., CCSP)"
          },
          {
            "name": "location",
            "in": "query",
            "required": false,
            "schema": { "type": "string" },
            "description": "Exception location / class name (e.g., CCSP_IP_GetRatesFlyoutInfo)"
          }
        ],
        "responses": {
          "200": {
            "description": "Matching PS Exception Logs",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExceptionLogResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ExceptionLogResponse": {
        "type": "object",
        "properties": {
          "exceptions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "Id": { "type": "string" },
                "ExceptionLogSeq": { "type": "string" },
                "Application": { "type": "string" },
                "ExceptionLocation": { "type": "string" },
                "ExceptionType": { "type": "string" },
                "SeverityLevel": { "type": "string" },
                "ErrorMessage": { "type": "string" },
                "LineNumber": { "type": "integer" },
                "Owner": { "type": "string" },
                "CreatedDate": { "type": "string" }
              }
            }
          },
          "count": { "type": "integer" }
        }
      }
    }
  }
}
